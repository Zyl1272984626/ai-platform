{
  "admin-sys-code": {
    "pageName": "代码管理",
    "url": "/admin/index.html#/sys/code",
    "description": "系统代码/字典管理页面，支持代码的增删改查，用于维护系统中使用的各类枚举值和字典数据",
    "expectedElements": ["搜索框", "新增按钮", "数据表格", "操作按钮(编辑/删除)", "分页组件"],
    "apiEndpoints": [
      { "method": "GET", "path": "/api/sys/code/page", "description": "分页查询代码列表" },
      { "method": "POST", "path": "/api/sys/code/save", "description": "新增或编辑代码" },
      { "method": "POST", "path": "/api/sys/code/delete", "description": "删除代码" }
    ],
    "interactions": [
      { "action": "点击新增按钮", "expected": "弹窗打开，表单字段为空" },
      { "action": "点击编辑按钮(某行)", "expected": "弹窗打开，表单数据回填" },
      { "action": "点击删除按钮(某行)", "expected": "出现确认弹窗" },
      { "action": "在搜索框输入关键词", "expected": "列表按关键词过滤" },
      { "action": "点击分页按钮", "expected": "列表显示下一页数据" }
    ],
    "commonIssues": ["编辑数据不回填", "删除后列表不刷新", "搜索结果不正确"]
  },
