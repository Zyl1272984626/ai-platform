# AI Platform 环境变量配置
# 复制此文件为 .env 并填入实际值
# 也可以启动后在浏览器 /settings 页面配置（推荐）

# ========== 必须配置 ==========

# 主系统代码路径（Agent/E2E 测试的工作目录）
PROJECT_ROOT=C:/FengSuKeJi/agent

# ========== AI 认证 ==========

# Anthropic API Key（E2E 测试 AI Agent 使用）
# 缺少此变量时 E2E AI 功能不可用，会降级为规则模式
# 获取地址: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ========== 服务配置 ==========

# 服务端口
PORT=3100

# AI Platform 根目录（可选，默认为主系统同级的 ai-platform）
AI_PLATFORM_ROOT=C:/FengSuKeJi/ai-platform

# ========== 禅道（可选） ==========

ZENTAO_URL=https://zentao.example.com
ZENTAO_ACCOUNT=bot
ZENTAO_PASSWORD=your_password

# ========== 通知（可选） ==========

WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
SMTP_HOST=smtp.example.com
EMAIL_FROM=ai-platform@example.com
EMAIL_USER=your_email
EMAIL_PASSWORD=your_password

# ========== 其他（可选） ==========

# 高德地图 Key（部署学校时使用）
AMAP_KEY=your_amap_key
