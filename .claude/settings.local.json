{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "mcp-server-mysql": {
      "command": "npx",
      "args": [
        "-y",
        "@benborla29/mcp-server-mysql"
      ],
      "env": {
        "MYSQL_HOST": "192.168.1.249",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "fskj@123",
        "MYSQL_DB": "agent_portal",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(where:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(taskkill:*)",
      "Bash(timeout:*)",
      "Bash(jar tf:*)",
      "Bash(jar:*)",
      "Bash(sed:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(wmic:*)",
      "Bash(df:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(wc:*)",
